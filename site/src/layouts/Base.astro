---
// Shared chrome: head, design tokens, nav, footer. Map pages add their
// own page-specific styles on top.
const { title, path = "/" } = Astro.props;
const DATA_BASE = import.meta.env.PUBLIC_DATA_BASE ?? "/data";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="canonical" href={new URL(path, "https://methane.purr.io/")} />
    <meta
      name="description"
      content="Peer-expectation outlier scores for vented, flared and fuel gas — Alberta facilities and Texas leases, from public regulatory data."
    />
    <script>
      if (location.hostname === "ab-methane.purr.io")
        location.replace("https://methane.purr.io" + location.pathname);
    </script>
  </head>
  <body data-data-base={DATA_BASE}>
    <nav class="topnav">
      <span class="brand">Methane Outliers</span>
      <a href="https://github.com/rbhughes/methane-outliers">GitHub</a>
    </nav>
    <slot />
    <footer>
      <slot name="footer" />
      <p>
        Pipeline:
        <a href="https://github.com/rbhughes/methane-outliers">methane-outliers</a>
        on <a href="https://github.com/rbhughes/petrinex-etl">petrinex-etl</a>
        and <a href="https://github.com/rbhughes/rrc-etl">rrc-etl</a>.
        Basemap tiles by <a href="https://openfreemap.org">OpenFreeMap</a>;
        county boundaries: US Census Bureau.
      </p>
    </footer>
  </body>
</html>

<style is:global>
  /* Committed "medium" look built from Bryan's iTerm Fairy (Floss)
     scheme: dusty-purple ground, candy-pink interactive accent, mint
     and gold as spot colors. The sequential dot ramp is unchanged
     because dots render on the light basemap inside the map boxes,
     not on the page surface. */
  :root {
    color-scheme: dark;
    --page: #5a5475;
    --surface: #4f4a66;
    --raised: #8077a8;
    --ink: #f8f8f2;
    --ink-2: #e4e0ee;
    --muted: #b8b0d2;
    --hairline: #6f6791;
    --border: rgba(248, 248, 242, 0.16);
    /* Sequential red-orange (OrRd), light -> dark on the light basemap */
    --seq-150: #fdd49e;
    --seq-300: #fc8d59;
    --seq-450: #ef6548;
    --seq-550: #d7301f;
    --seq-700: #990000;
    --accent: #ffb8d1;
    --accent-2: #c2ffdf;
    --gold: #e6c000;
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    background: var(--page);
    color: var(--ink);
    font: 15px/1.5 system-ui, -apple-system, "Segoe UI", sans-serif;
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }
  a { color: var(--accent); }
  .topnav {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.55rem 1.4rem;
    border-bottom: 1px solid var(--hairline);
    background: var(--surface);
  }
  .topnav .brand {
    font-weight: 700;
    letter-spacing: -0.01em;
    margin-right: 0.9rem;
  }
  .topnav a {
    color: var(--ink-2);
    text-decoration: none;
    padding: 0.25rem 0.7rem;
    border-radius: 7px;
    font-size: 0.92rem;
  }
  .topnav a:hover { background: var(--page); }
  .topnav a.active { background: var(--ink); color: var(--surface); }
  .masthead {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.1rem 1.4rem 0.4rem;
    flex-wrap: wrap;
  }
  h1 { margin: 0; font-size: 1.45rem; letter-spacing: -0.01em; }
  .tagline { margin: 0.15rem 0 0; color: var(--ink-2); max-width: 46rem; }
  .window-badge {
    color: var(--ink-2);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.25rem 0.8rem;
    font-size: 0.85rem;
    white-space: nowrap;
  }
  .tiles {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
    gap: 0.7rem;
    padding: 0.8rem 1.4rem 0.2rem;
  }
  .tile {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 0.7rem 0.9rem;
  }
  .tile .label { color: var(--ink-2); font-size: 0.82rem; }
  .tile .value { font-size: 1.5rem; font-weight: 650; margin-top: 0.1rem; }
  .tile .unit { color: var(--muted); font-size: 0.82rem; font-weight: 400; }
  .controls {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    padding: 0.7rem 1.4rem;
  }
  .metric-toggle {
    display: inline-flex;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 9px;
    padding: 3px;
  }
  .metric-toggle button {
    border: 0;
    background: transparent;
    color: var(--ink-2);
    font: inherit;
    font-size: 0.9rem;
    padding: 0.3rem 0.9rem;
    border-radius: 6px;
    cursor: pointer;
  }
  .metric-toggle button[aria-selected="true"] {
    background: var(--ink);
    color: var(--surface);
    font-weight: 600;
  }
  .legend {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--ink-2);
    font-size: 0.8rem;
  }
  .legend-title { margin-right: 0.2rem; color: var(--muted); }
  .swatch {
    width: 12px; height: 12px; border-radius: 50%;
    background: var(--c);
    display: inline-block;
  }
  .swatch.sq { border-radius: 3px; }
  .swatch.ring { outline: 1.5px solid var(--ink); outline-offset: 1px; }
  .layout {
    display: flex;
    gap: 0.9rem;
    padding: 0 1.4rem 1rem;
    flex: 1;
    min-height: 480px;
  }
  .map-box {
    flex: 2.2;
    min-width: 0;
    border-radius: 12px;
    border: 1px solid var(--border);
    background: var(--surface);
  }
  .panel {
    flex: 1;
    min-width: 300px;
    max-width: 430px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 0.9rem 1rem;
    overflow: auto;
    max-height: 72vh;
  }
  .panel h2 { margin: 0; font-size: 1.02rem; }
  .panel-note { color: var(--muted); font-size: 0.8rem; margin: 0.25rem 0 0.6rem; }
  .outliers { width: 100%; border-collapse: collapse; font-size: 0.85rem; }
  .outliers th {
    text-align: left; color: var(--muted); font-weight: 500;
    border-bottom: 1px solid var(--hairline); padding: 0.25rem 0.3rem;
  }
  .outliers td {
    padding: 0.34rem 0.3rem;
    border-bottom: 1px solid var(--hairline);
    vertical-align: top;
  }
  .outliers tr[data-id] { cursor: pointer; }
  .outliers tr[data-id]:hover td { background: var(--page); }
  .outliers .num { text-align: right; font-variant-numeric: tabular-nums; }
  .outliers .fac { font-weight: 600; }
  .outliers .sub { color: var(--muted); font-size: 0.76rem; display: block; }
  footer {
    color: var(--muted);
    font-size: 0.78rem;
    padding: 0.4rem 1.4rem 1rem;
  }
  footer p { margin: 0.2rem 0; }
  .maplibregl-popup-content {
    font: 13px/1.45 system-ui, -apple-system, "Segoe UI", sans-serif;
    color: var(--ink);
    background: var(--surface);
    border-radius: 8px;
    box-shadow: 0 2px 12px rgba(11, 11, 11, 0.35);
    padding: 0.6rem 0.75rem;
  }
  .maplibregl-popup-anchor-bottom .maplibregl-popup-tip {
    border-top-color: var(--surface);
  }
  .maplibregl-popup-anchor-top .maplibregl-popup-tip {
    border-bottom-color: var(--surface);
  }
  .maplibregl-popup-anchor-left .maplibregl-popup-tip {
    border-right-color: var(--surface);
  }
  .maplibregl-popup-anchor-right .maplibregl-popup-tip {
    border-left-color: var(--surface);
  }
  .pop-name { font-weight: 650; }
  .pop-sub { color: var(--muted); font-size: 0.76rem; margin-bottom: 0.3rem; }
  .pop-row { display: flex; justify-content: space-between; gap: 1rem; }
  .pop-row .v { font-variant-numeric: tabular-nums; font-weight: 600; }
  .pop-flag { color: #ff857f; font-weight: 650; margin-top: 0.25rem; }
  @media (max-width: 900px) {
    .layout { flex-direction: column; }
    .map-box { min-height: 420px; flex: none; }
    .panel { max-width: none; max-height: 40vh; }
  }
</style>
