---
import Base from "../layouts/Base.astro";
---

<Base title="Texas Methane Outliers" path="/tx/">
  <header class="masthead">
    <div>
      <h1>Texas: lease outliers</h1>
      <p class="tagline">
        Flared+vented and lease-fuel gas at ~150,000 producing leases,
        scored against oil/gas-class and size peers. Railroad Commission
        of Texas PDQ data. Texas bulk data never splits flared from
        vented, so the combined series is shown.
      </p>
    </div>
    <span class="window-badge" id="window-badge" hidden></span>
  </header>

  <section class="tiles" id="tiles" aria-label="State totals"></section>

  <div class="controls">
    <div class="metric-toggle" role="tablist" aria-label="Metric">
      <button role="tab" data-metric="flare_vent" aria-selected="true">
        Flared + vented</button>
      <button role="tab" data-metric="fuel" aria-selected="false">
        Lease fuel</button>
    </div>
    <div class="legend" aria-hidden="true">
      <span class="legend-title">Peer percentile</span>
      <span class="swatch" style="--c: var(--seq-150)"></span><span>&le;50</span>
      <span class="swatch" style="--c: var(--seq-300)"></span><span>75</span>
      <span class="swatch" style="--c: var(--seq-450)"></span><span>90</span>
      <span class="swatch" style="--c: var(--seq-550)"></span><span>95</span>
      <span class="swatch ring" style="--c: var(--seq-700)"></span><span>outlier</span>
    </div>
  </div>

  <main class="layout">
    <div id="map" class="map-box" role="application" aria-label="County map"></div>
    <aside class="panel">
      <h2 id="panel-title">Top outlier leases</h2>
      <p class="panel-note">
        &ge;95th percentile of their peer group and &ge;2,000 MCF over the
        window. Click a row to locate it.
      </p>
      <table class="outliers" id="outliers">
        <thead>
          <tr><th scope="col">Lease</th><th scope="col">Operator</th>
            <th scope="col" class="num">MMcf</th>
            <th scope="col" class="num">&times; peer</th></tr>
        </thead>
        <tbody></tbody>
      </table>
    </aside>
  </main>

  <p slot="footer" id="attribution">
    Source: Railroad Commission of Texas, Production Data Query dump and
    public GIS well locations. Non-commercial demonstration; derived
    statistics only. Each lease is drawn at the median surface location
    of its wells; volumes in MCF at 14.65 psi / 60&deg;F.
  </p>

  <script src="../scripts/tx.js"></script>
</Base>
