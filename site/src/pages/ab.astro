---
import Base from "../layouts/Base.astro";
---

<Base title="Alberta Methane Outliers" path="/ab/">
  <header class="masthead">
    <div>
      <h1>Alberta: facility outliers</h1>
      <p class="tagline">
        Vented, flared and fuel gas at ~23,000 reporting facilities,
        scored against subtype-and-size peers.
        <a href="https://www.petrinex.ca">Petrinex</a> public data.
      </p>
    </div>
    <span class="window-badge" id="window-badge" hidden></span>
  </header>

  <section class="tiles" id="tiles" aria-label="Provincial totals"></section>

  <div class="controls">
    <div class="metric-toggle" role="tablist" aria-label="Metric">
      <button role="tab" data-metric="vent" aria-selected="true">Vented</button>
      <button role="tab" data-metric="flare" aria-selected="false">Flared</button>
      <button role="tab" data-metric="fuel" aria-selected="false">Fuel</button>
    </div>
    <div class="legend" aria-hidden="true">
      <span class="legend-title">Peer percentile</span>
      <span class="swatch" style="--c: var(--seq-150)"></span><span>&le;50</span>
      <span class="swatch" style="--c: var(--seq-300)"></span><span>75</span>
      <span class="swatch" style="--c: var(--seq-450)"></span><span>90</span>
      <span class="swatch" style="--c: var(--seq-550)"></span><span>95</span>
      <span class="swatch ring" style="--c: var(--seq-700)"></span><span>outlier</span>
    </div>
  </div>

  <main class="layout">
    <div id="map" class="map-box" role="application" aria-label="Facility map"></div>
    <aside class="panel">
      <h2 id="panel-title">Top outliers</h2>
      <p class="panel-note">
        &ge;95th percentile of their peer group and &ge;50 e3m&sup3; over the
        window. Click a row to locate it.
      </p>
      <table class="outliers" id="outliers">
        <thead>
          <tr><th scope="col">Facility</th><th scope="col">Operator</th>
            <th scope="col" class="num">e3m&sup3;</th>
            <th scope="col" class="num">&times; peer</th></tr>
        </thead>
        <tbody></tbody>
      </table>
    </aside>
  </main>

  <p slot="footer" id="attribution">
    Contains information licensed from Petrinex; data &copy; Government of
    Alberta. Non-commercial demonstration; derived statistics only.
    Facility locations are DLS centroids (median accuracy ~270 m).
  </p>

  <script src="../scripts/ab.js"></script>
</Base>
